<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tra Cứu Kết Quả Học Tập THCS</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 20px; background-color: #f8f9fa; color: #333; }
        h2 { color: #0056b3; text-align: center; }
        .search-container { margin: 20px auto; display: flex; gap: 10px; max-width: 500px; }
        #searchInput { flex: 1; padding: 10px 15px; font-size: 15px; border: 2px solid #007bff; border-radius: 4px; outline: none; }
        .search-container button { padding: 10px 20px; font-size: 15px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .search-container button:hover { background-color: #0056b3; }
        .table-responsive { overflow-x: auto; margin-top: 20px; background: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.05); border-radius: 8px; }
        table { border-collapse: collapse; width: 100%; font-size: 13px; min-width: 1200px; }
        th, td { border: 1px solid #dee2e6; text-align: center; padding: 10px 6px; }
        th { background-color: #007bff; color: white; font-weight: bold; white-space: nowrap; }
        tr:nth-child(even) { background-color: #f8f9fa; }
        .status-msg { text-align: center; font-size: 15px; margin-top: 20px; font-weight: bold; }
        .error { color: #dc3545; }
        .loading { color: #007bff; }
    </style>
</head>
<body>

    <h2>🔍 HỆ THỐNG TRA CỨU ĐIỂM HỌC SINH</h2>
    
    <div class="search-container">
        <input type="text" id="searchInput" onkeydown="if(event.key === 'Enter') performSearch()" placeholder="Nhập chính xác mã định danh để xem điểm...">
        <button onclick="performSearch()">Tìm kiếm</button>
    </div>

    <div class="table-responsive" id="output"></div>

    <script>
        // ĐIỀN ĐƯỜNG LINK URL GOOGLE APPS SCRIPT BẠN VỪA DEPLOY LẠI VÀO ĐÂY:
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxyHuAk1y6Mm25xTCh5Gy11KsQRDVgCvkt-6sTDh2NxXYHZlXmEiykydvOfKkbu5BSH/exec";

        function performSearch() {
            const searchTerm = document.getElementById("searchInput").value.trim();
            const outputDiv = document.getElementById("output");

            if (searchTerm === "") {
                outputDiv.innerHTML = "<p class='status-msg error'>Vui lòng nhập mã định danh để tìm kiếm.</p>";
                return;
            }

            outputDiv.innerHTML = "<p class='status-msg loading'>⏳ Đang kết nối dữ liệu an toàn, vui lòng đợi giây lát...</p>";

            // Xóa script cũ nếu có trước khi tạo yêu cầu mới
            const oldScript = document.getElementById("jsonpScript");
            if (oldScript) oldScript.remove();

            // Tạo giải pháp JSONP để bẻ gãy hoàn toàn lỗi CORS
            const script = document.createElement("script");
            script.id = "jsonpScript";
            script.src = `${SCRIPT_URL}?id=${encodeURIComponent(searchTerm)}&callback=handleSpreadsheetResponse`;
            
            // Xử lý khi script gặp lỗi kết nối mạng vật lý
            script.onerror = function() {
                outputDiv.innerHTML = "<p class='status-msg error'>❌ Không thể kết nối tới máy chủ Google. Vui lòng thử lại sau.</p>";
            };

            document.body.appendChild(script);
        }

        // Hàm tiếp nhận dữ liệu đổ về từ Google Sheets sau khi xử lý JSONP thành công
        function handleSpreadsheetResponse(data) {
            const outputDiv = document.getElementById("output");
            
            if (data.success) {
                let tableHTML = "<table><tr>";
                
                // Hiển thị tiêu đề
                data.headers.forEach(header => {
                    tableHTML += `<th>${header.toString().replace(/\n/g, "<br>")}</th>`;
                });
                tableHTML += "</tr><tr>";

                // Hiển thị điểm số học sinh
                data.studentData.forEach(cell => {
                    tableHTML += `<td>${cell !== undefined && cell !== null ? cell : ""}</td>`;
                });
                tableHTML += "</tr></table>";
                
                outputDiv.innerHTML = tableHTML;
            } else {
                outputDiv.innerHTML = `<p class='status-msg error'>❌ Không tìm thấy mã định danh phù hợp trong hệ thống.</p>`;
            }

            // Dọn dẹp thẻ script sau khi nhận xong dữ liệu
            const script = document.getElementById("jsonpScript");
            if (script) script.remove();
        }
    </script>
</body>
</html>
